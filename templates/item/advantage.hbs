<section class="body">
  {{> "systems/gmentor/templates/item/trait-fields.hbs" trait=trait}}

  {{!-- Части составной черты («Бионическая нога»): у каждой свои цена, модификаторы и эффекты --}}
  <h4 data-tooltip="GMENTOR.ComponentsHint">
    {{localize "GMENTOR.Components"}}
    <a data-action="addComponent" data-tooltip="GMENTOR.Add"><i class="fa-solid fa-plus" inert></i></a>
  </h4>
  {{#if components.length}}
  <ol class="components">
    {{#each components as |component|}}
    <li class="component {{#if component.expanded}}expanded{{/if}}">
      <div class="component-row">
        <input type="text" name="{{component.prefix}}.name" value="{{component.name}}" placeholder="{{localize "Name"}}">
        {{#if component.pointsPerLevel}}
        <label class="component-levels">{{localize "GMENTOR.LevelLabel"}}
          <input type="number" name="{{component.prefix}}.levels" value="{{component.levels}}" min="0"></label>
        {{/if}}
        {{#if component.enabledModifiers}}<span class="component-modifiers">{{component.enabledModifiers}}</span>{{/if}}
        <span class="component-cost">{{component.cost}}</span>
        <a data-action="toggleComponent" data-component="{{component.component}}" data-tooltip="GMENTOR.ComponentDetails">
          <i class="fa-solid {{#if component.expanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" inert></i></a>
        <a data-action="deleteComponent" data-component="{{component.component}}" data-tooltip="GMENTOR.Delete">
          <i class="fa-solid fa-trash" inert></i></a>
      </div>
      {{#if component.expanded}}
      <div class="component-details">
        {{> "systems/gmentor/templates/item/trait-fields.hbs" trait=component}}
      </div>
      {{/if}}
    </li>
    {{/each}}
  </ol>
  {{/if}}

  <p class="result">{{localize "GMENTOR.Cost"}}: <strong>{{system.cost}}</strong></p>
</section>
