{{!--
  Эффекты черты или модификатора. Параметры: features — массив, prefix — имя поля в форме
  ("system.features", "system.modifiers.2.features"), modifier — индекс модификатора или пусто для самой черты.
--}}
<ul class="features">
  {{#each features}}
  <li class="feature">
    <input type="hidden" name="{{../prefix}}.{{@index}}.type" value="{{type}}">
    <span class="feature-type">{{localize (concat "GMENTOR.FeatureType." type)}}</span>
    {{!-- Поля типа; пара «способ сравнения + значение» переносится целиком, если не хватает ширины --}}
    <span class="feature-fields">
      {{#if (eq type "attribute")}}
      <select name="{{../prefix}}.{{@index}}.target">{{selectOptions @root.choices.bonusTarget selected=target localize=true}}</select>
      {{else if (eq type "reaction")}}
      <input type="text" name="{{../prefix}}.{{@index}}.situation" value="{{situation}}" placeholder="{{localize "GMENTOR.SituationPlaceholder"}}">
      {{else if (eq type "skill")}}
      <span class="feature-pair">
        <select name="{{../prefix}}.{{@index}}.nameCompare">{{selectOptions @root.choices.compare selected=nameCompare localize=true}}</select>
        <input type="text" name="{{../prefix}}.{{@index}}.name" value="{{name}}" placeholder="fast-draw">
      </span>
      <span class="feature-pair">
        <select name="{{../prefix}}.{{@index}}.specializationCompare" data-tooltip="GMENTOR.Specialization">{{selectOptions @root.choices.compare selected=specializationCompare localize=true}}</select>
        <input type="text" name="{{../prefix}}.{{@index}}.specialization" value="{{specialization}}" placeholder="{{localize "GMENTOR.Specialization"}}">
      </span>
      {{else if (eq type "spell")}}
      <span class="feature-pair">
        <select name="{{../prefix}}.{{@index}}.collegeCompare">{{selectOptions @root.choices.compare selected=collegeCompare localize=true}}</select>
        <input type="text" name="{{../prefix}}.{{@index}}.college" value="{{college}}" placeholder="{{localize "GMENTOR.Spell.college"}}">
      </span>
      {{/if}}
    </span>
    <input class="feature-amount" type="number" name="{{../prefix}}.{{@index}}.amount" value="{{amount}}" step="any">
    <label class="feature-per-level" data-tooltip="GMENTOR.PerLevelHint">
      <input type="checkbox" name="{{../prefix}}.{{@index}}.perLevel" {{checked perLevel}}> {{localize "GMENTOR.PerLevel"}}
    </label>
    <a data-action="deleteFeature" data-modifier="{{../modifier}}" data-index="{{@index}}" data-tooltip="GMENTOR.Delete">
      <i class="fa-solid fa-trash" inert></i></a>
  </li>
  {{/each}}
</ul>
<p class="feature-add">
  {{localize "GMENTOR.AddFeature"}}:
  {{#each @root.featureTypes}}
  <a data-action="addFeature" data-modifier="{{../modifier}}" data-type="{{this}}">
    <i class="fa-solid fa-plus" inert></i> {{localize (concat "GMENTOR.FeatureType." this)}}</a>
  {{/each}}
</p>
