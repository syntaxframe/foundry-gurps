{{#*inline "learnedList"}}
<h3>
  {{localize title}}
  <a class="add" data-action="createItem" data-type="{{type}}" data-tooltip="GMENTOR.Add"><i class="fa-solid fa-plus" inert></i></a>
</h3>
<table class="item-table">
  <thead><tr>
    <th class="name">{{localize "Name"}}</th>
    <th>{{localize "GMENTOR.Difficulty.label"}}</th>
    <th>{{localize "GMENTOR.Points.label"}}</th>
    <th>{{localize "GMENTOR.Relative"}}</th>
    <th>{{localize "GMENTOR.Level"}}</th>
    <th></th>
  </tr></thead>
  <tbody>
    {{#each items}}
    <tr data-item-id="{{id}}">
      <td class="name">
        <a data-action="editItem">{{name}}{{#if system.specialization}} ({{system.specialization}}){{/if}}</a>
      </td>
      <td>{{#if system.attribute}}{{localize (concat "GMENTOR.AttributeAbbr." system.attribute)}}{{else}}{{localize "GMENTOR.AttributeAbbr.iq"}}{{/if}}/{{system.difficulty}}</td>
      <td>{{system.points}}</td>
      <td>{{#if (ne system.relative null)}}{{numberFormat system.relative sign=true}}{{/if}}</td>
      <td>
        {{#if (ne system.level null)}}
        <a class="rollable" data-action="roll" data-label="{{name}}" data-value="{{system.level}}">{{system.level}}</a>
        {{else}}—{{/if}}
      </td>
      <td>{{> "systems/gmentor/templates/actor/item-row.hbs"}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{/inline}}

<section class="tab skills {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{> learnedList title="GMENTOR.Skills" items=skills type="skill"}}
  {{> learnedList title="GMENTOR.Spells" items=spells type="spell"}}
</section>
