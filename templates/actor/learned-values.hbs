{{!-- Очки умения или заклинания в квадратных скобках (правятся прямо в строке), атрибут и уровень --}}
<label class="item-points" data-tooltip="GMENTOR.Points.label">
  [<input type="number" data-item-field="system.points" value="{{item.system.points}}" min="0">]
</label>
<span class="item-stat">{{stat}}</span>
{{#if (ne item.system.level null)}}
{{!-- Заклинание творится через окно сотворения (Shift — простой бросок), умение — бросок против уровня --}}
<a class="item-level rollable {{#if bonusHint}}boosted{{/if}}" data-action="{{#if (eq item.type "spell")}}castSpell{{else}}roll{{/if}}" data-label="{{item.name}}"
   data-value="{{item.system.level}}" {{#if bonusHint}}data-tooltip-text="{{bonusHint}}"{{/if}}>{{item.system.level}}</a>
{{else}}
<span class="item-level">—</span>
{{/if}}
