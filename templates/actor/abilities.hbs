<section class="tab abilities {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  <div class="columns">
    <div class="card item-list">
      {{> "systems/gmentor/templates/actor/list-header.hbs" list=advantages}}
      <ol>
        {{#each advantages.rows}}
        <li class="item-row draggable" data-item-id="{{item.id}}">
          <a class="item-name" data-action="editItem">{{item.name}}</a>
          {{> "systems/gmentor/templates/actor/item-row.hbs"}}
          <span class="item-cost">{{item.system.cost}}</span>
          <div class="item-details">
            {{#if item.system.pointsPerLevel}}
            <label>{{localize "GMENTOR.LevelLabel"}}
              <input type="number" data-item-field="system.levels" value="{{item.system.levels}}" min="0"></label>
            {{/if}}
            {{#if item.system.cr}}
            <span>{{localize "GMENTOR.SelfControlLabel"}}
              <a class="rollable" data-action="roll" data-label="{{item.name}}" data-value="{{item.system.crTarget}}">{{item.system.cr}}</a>
              {{#if (ne item.system.crTarget item.system.cr)}}<span class="warning">➞ {{item.system.crTarget}}</span>{{/if}}
            </span>
            {{/if}}
            {{#each item.system.modifiers}}
            {{#if enabled}}<span class="item-modifier">{{name}} ({{numberFormat value sign=true}}%)</span>{{/if}}
            {{/each}}
          </div>
          {{#if description}}<div class="item-description">{{{description}}}</div>{{/if}}
        </li>
        {{/each}}
      </ol>
    </div>

    <div class="card item-list">
      {{> "systems/gmentor/templates/actor/list-header.hbs" list=skills}}
      <ol>
        {{#each skills.rows}}
        <li class="item-row draggable" data-item-id="{{item.id}}">
          <a class="item-name" data-action="editItem">{{item.name}}</a>
          {{> "systems/gmentor/templates/actor/item-row.hbs"}}
          {{> "systems/gmentor/templates/actor/learned-values.hbs"}}
          {{#if item.system.specialization}}<div class="item-details">{{item.system.specialization}}</div>{{/if}}
          {{#if description}}<div class="item-description">{{{description}}}</div>{{/if}}
        </li>
        {{/each}}
      </ol>
    </div>
  </div>
</section>
