{{!-- Заголовок списка с панелью инструментов, как list_toolbar в GMentor --}}
<h3>
  {{localize list.title}}
  <span class="list-tools">
    <a class="{{#if list.showDescriptions}}active{{/if}}" data-action="toggleDescriptions" data-type="{{list.type}}"
       data-tooltip="GMENTOR.ShowDescriptions"><i class="fa-solid fa-align-left" inert></i></a>
    <a data-action="sortByName" data-type="{{list.type}}" data-tooltip="GMENTOR.SortByName">
      <i class="fa-solid fa-arrow-down-a-z" inert></i></a>
    <a data-action="createItem" data-type="{{list.type}}" data-tooltip="GMENTOR.Add"><i class="fa-solid fa-plus" inert></i></a>
  </span>
</h3>
